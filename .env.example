# guild-builder environment variables
NATS_URL=nats://<your-nats-host>:4222
NATS_TOKEN=
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GUILD_PORT=8443
GUILD_NAME=builder
NATS_PREFIX=citadel.builder

# Tenant provisioning orchestrator (TENANT-PROVISION-FABRIC-001 §6).
# Set PROVISION_ORCHESTRATOR=on to wire the inbound/outbound NATS bridge
# at process start. Subjects are operator-controlled — never hardcoded.
PROVISION_ORCHESTRATOR=off
PROVISION_INBOUND_SUBJECT=
PROVISION_OUTBOUND_PREFIX=

# Builder -> Research automation pipe.
# Set RESEARCH_SIGNAL_PIPE=on to forward Builder thesis telemetry to a
# Research guild subject namespace using operator-controlled subjects.
RESEARCH_SIGNAL_PIPE=off
RESEARCH_PIPE_INBOUND_SUBJECT=
RESEARCH_PIPE_OUTBOUND_PREFIX=
RESEARCH_PIPE_SOURCE_GUILD=builder
RESEARCH_PIPE_TARGET_GUILD=research
RESEARCH_PIPE_NAMESPACE=thesis
