GUILD_PORT=8443
NATS_URL=nats://127.0.0.1:4222
NATS_TOKEN=
NATS_PREFIX=citadel.builder
PROVISION_ORCHESTRATOR=off
PROVISION_INBOUND_SUBJECT=
PROVISION_OUTBOUND_PREFIX=

# Datadog Observability Bridge (citadel.builder.datadog.*)
# Set DATADOG_BRIDGE=on to enable the NATS↔Datadog bridge at process start.
DATADOG_BRIDGE=off
DD_API_KEY=
DD_APP_KEY=
DD_SITE=us5.datadoghq.com
DATADOG_NATS_PREFIX=citadel.builder.datadog
DATADOG_POLL_INTERVAL_MS=60000

# Optional outbound remediation publishers
# Enable to fan monitor events out to external systems.
DATADOG_OUTBOUND_ENABLED=off
POSTHOG_HOST=
POSTHOG_API_KEY=
POSTHOG_DISTINCT_ID_PREFIX=datadog
CUSTOMERIO_REGION=us
CUSTOMERIO_SITE_ID=
CUSTOMERIO_TRACK_API_KEY=
