# guild-builder environment variables
NATS_URL=nats://<your-nats-host>:4222
NATS_TOKEN=

# Supabase Vault (bootstrap secret for runtime credential resolution)
# All other API keys are fetched from Vault at agent boot using this key.
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GUILD_PORT=8443
GUILD_NAME=builder
NATS_PREFIX=citadel.builder

# Tenant provisioning orchestrator (TENANT-PROVISION-FABRIC-001 §6).
# Set PROVISION_ORCHESTRATOR=on to wire the inbound/outbound NATS bridge
# at process start. Subjects are operator-controlled — never hardcoded.
PROVISION_ORCHESTRATOR=off
PROVISION_INBOUND_SUBJECT=
PROVISION_OUTBOUND_PREFIX=

# Nexus Tamagotchi Agent (citadel.builder.nexus.*)
# Gamified AI companion with XP/TP progression, professor network, and governance
NEXUS_TAMAGOTCHI=off
NEXUS_AGENT_ID=nexus-001
NEXUS_NATS_PREFIX=citadel.builder.nexus
NEXUS_WEB_ENRICHMENT_ENDPOINT=
NEXUS_WEB_ENRICHMENT_API_KEY=

# Datadog observability bridge (off by default)
DATADOG_BRIDGE=off
DD_API_KEY=
DD_APP_KEY=
DD_SITE=us5.datadoghq.com
DATADOG_NATS_PREFIX=citadel.builder.datadog
DATADOG_POLL_INTERVAL_MS=60000

# Security watcher — polls Datadog security signals and findings
DATADOG_SECURITY_ENABLED=off

# LLM observer — monitors Nvidia NIM / vLLM inference metrics
DATADOG_LLM_ENABLED=off
DATADOG_LLM_LATENCY_THRESHOLD_MS=5000
DATADOG_LLM_ERROR_RATE_THRESHOLD=0.05
DATADOG_LLM_THROUGHPUT_DROP_RATIO=0.4
DATADOG_LLM_PROMPT_TOKEN_COST_USD=0
DATADOG_LLM_COMPLETION_TOKEN_COST_USD=0
DATADOG_LLM_MODEL=
DATADOG_LLM_APPLICATION=

# Automation engine — accepts NATS commands for monitor lifecycle actions
DATADOG_AUTOMATION_ENABLED=off

# Integration bridge — forwards PostHog/Customer.io/GitLab/Stripe events
DATADOG_INTEGRATIONS_ENABLED=off

# Debug logging
DATADOG_BRIDGE_DEBUG=false
