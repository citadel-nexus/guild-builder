# guild-builder environment variables
NATS_URL=nats://<your-nats-host>:4222
NATS_TOKEN=
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
GUILD_PORT=8443
GUILD_NAME=builder
NATS_PREFIX=citadel.builder

# Tenant provisioning orchestrator (TENANT-PROVISION-FABRIC-001 §6).
# Set PROVISION_ORCHESTRATOR=on to wire the inbound/outbound NATS bridge
# at process start. Subjects are operator-controlled — never hardcoded.
PROVISION_ORCHESTRATOR=off
PROVISION_INBOUND_SUBJECT=
PROVISION_OUTBOUND_PREFIX=

# Nexus Tamagotchi Agent (citadel.builder.nexus.*)
# Gamified AI companion with XP/TP progression, professor network, and governance
NEXUS_TAMAGOTCHI=off
NEXUS_AGENT_ID=nexus-001
NEXUS_NATS_PREFIX=citadel.builder.nexus
