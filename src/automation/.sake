module: automation
guild: builder
srs: [SRS-CN-BUILDER-INTEGRATION-001, SRS-PROVISION-ORCHESTRATOR-001]
dispatch: DISP-BUILDER-INTEGRATION-001
owns: [src/automation/research-pipe.ts, src/automation/auto-start.ts]
inputs: [RESEARCH_PIPE_INBOUND_SUBJECT, RESEARCH_PIPE_OUTBOUND_PREFIX]
outputs: [ResearchSignalPipe, maybeStartResearchSignalPipe]
invariants:
  - opt-in startup through RESEARCH_SIGNAL_PIPE
  - preserve correlation fields when forwarding
  - log failed subscriptions and allow explicit restart
  - stop discards buffered messages before resolving
  - core NATS delivery is not durable or exactly once
