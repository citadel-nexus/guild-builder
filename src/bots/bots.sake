module: bots
srs: SRS-BOT-TRACKER-001
owner: builder-guild
description: |
  Real-time tracking surface for autonomous agents (Bits AI, USO_MCP,
  Bits Codex, BITS-CODEGEN seat, IDE coding agents, GitHub Action
  workflow bots) acting inside the guild system.

  Subscribes to bot-activity NATS subjects, maintains an in-memory
  registry of recent events + last-seen status per bot, and exposes:

    GET /bots          — html dashboard (vanilla canvas2d)
    GET /bots/snapshot — current state as JSON
    GET /bots/stream   — Server-Sent Events stream of bot events

inputs:
  nats_subjects:
    default: citadel.builder.bot.>
    canonical_payload:
      bot_id: string (required, falls back to subject segment)
      bot_name: string (optional)
      bot_kind: agent | seat | workflow | webhook | unknown
      action: string (optional, falls back to subject suffix)
      status: idle | active | error | offline
      geo: { lat, lon }
      payload: object
  env:
    NATS_URL: required for the listener (UI runs without it)
    NATS_PREFIX: guild prefix, defaults to citadel.builder
    BOT_TRACKER_SUBJECTS: comma-separated override list
    BOT_TRACKER_DISABLED: "1" disables the listener (tests / dry-runs)

outputs:
  http_routes:
    - GET /bots
    - GET /bots/snapshot
    - GET /bots/stream
  in_memory:
    BotRegistry: snapshot() + subscribe(listener)

dependencies:
  runtime:
    - nats   # already approved single-dep policy
  dev: []

notes:
  - No new runtime dependencies. Visualization is vanilla Canvas2D
    served inline; no three.js, no CDN.
  - Subject patterns are env-driven per AGENTS.md / CLAUDE.md rules.
  - Geo for un-located bots is deterministic per bot_id so the UI
    does not jitter between snapshots.
