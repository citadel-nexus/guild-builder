module: bots
guild: builder
srs: [SRS-CN-BUILDER-INTEGRATION-001, SRS-BOT-TRACKER-001]
dispatch: DISP-BUILDER-INTEGRATION-001
contract: src/bots/bots.sake
inputs: [NATS_PREFIX, BOT_TRACKER_SUBJECTS, BOT_TRACKER_INGEST_TOKEN]
outputs: [BotRegistry, tryHandleBotRoute, startBotListener]
invariants:
  - HTTP ingestion enforces its configured token and 256 KiB limit
  - public event snapshots and listeners cannot mutate retained evidence
  - event retention is bounded and in memory
